/*
 * OFF <-- Left --> ON
 *
 * OFF <-- Right --> ON
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

// #define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
// #define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <dt-bindings/zmk/pointing.h>


#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4
#define GAME 5
#define GXTRA 6
#define PLATF 7

&led_strip {
    chain-length = <36>;
};


&nice_view_spi {
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};



/ {
    // 1. BEHAVIORS BLOCK
    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <148>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <80>;
            bindings = <&shifted>, <&kp>;
        };


    // add here




        

         // Standard hold-tap behavior engineered to support layer parameters
         // This natively satisfies Zephyr's binding verification engine
  /*     layer_ht: layer_hold_tap {
   *         compatible = "zmk,behavior-hold-tap";
   *         #binding-cells = <2>;
   *         tapping-term-ms = <200>;
   *         flavor = "hold-preferred";
   *         bindings = <&mo>, <&sl>; // Hold = Momentary Layer, Tap = Sticky Layer
   *      };
   */
         // Clean, zero-parameter Tap-Dance nodes mapping straight to the helper driver
   /*    td_lower: lower_tap_toggle {
    *        compatible = "zmk,behavior-tap-dance";
    *        #binding-cells = <0>;
    *        tapping-term-ms = <200>;
    *        bindings = <&layer_ht LOWER LOWER>, <&tog LOWER>;
    *       };
    *
    *  td_raise: raise_tap_toggle {
    *       compatible = "zmk,behavior-tap-dance";
    *        #binding-cells = <0>;
    *        tapping-term-ms = <200>;
    *        bindings = <&layer_ht RAISE RAISE>, <&tog RAISE>;
    *       };
    *
    *    td_mouse: mouse_tap_toggle {
    *        compatible = "zmk,behavior-tap-dance";
    *        #binding-cells = <0>;
    *        tapping-term-ms = <200>;
    *        bindings = <&layer_ht MOUSE MOUSE>, <&tog MOUSE>;
    *    };
    */
    };



    // 2. MACROS BLOCK
    macros {

    // Add this inside your macros { ... } block

        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        
        // New Em Dash macro configured safely for Windows -- call it lowercase &m_dash - only the label is called uppercase
        m_dsh: em_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "M_DSH";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = 
                <&macro_press>, <&kp LALT>,
                <&macro_tap>, <&kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N1>,
                <&macro_release>, <&kp LALT>;
    };

        
        // New En Dash macro configured safely for Windows
        n_dsh: en_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            label = "N_DSH";
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = 
                <&macro_press>, <&kp LALT>,
                <&macro_tap>, <&kp KP_N0 &kp KP_N1 &kp KP_N5 &kp KP_N0>,
                <&macro_release>, <&kp LALT>;
    };

         m_par: macro_parenthesis {
            label = "M_PAR";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <10>;
            bindings = <&macro_tap &kp LPAR &kp RPAR &kp LEFT>;
        };

         m_bkt: macro_brackets {
            label = "M_BKT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <10>;
            bindings = <&macro_tap &kp LBKT &kp RBKT &kp LEFT>;
        };

         m_brc: macro_braces {
            label = "M_BRC";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <10>;
            bindings = <&macro_tap &kp LS(LBKT) &kp LS(RBKT) &kp LEFT>;
        };

         m_lgt: macro_chevron_angle_brackets {
            label = "M_LGT";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <10>;
            bindings = <&macro_tap &kp LT &kp GT &kp LEFT>;
        };

         m_quo: macro_s_quotes {
            label = "M_QUO";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <10>;
            bindings = 
                <&macro_press>, <&kp LSHFT>,
                <&macro_tap>, <&kp N2 &kp N2>,
                <&macro_release>, <&kp LSHFT>,
                <&macro_press>, <&kp LEFT>;
        };



    };

    // Your existing keymap code continues below...





   // The conditional_layers block has been safely isolated and commented out here
   
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
   


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

/*
 * QWERTY / DEFAULT / BASE
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | 	= + |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |LALT  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  |  - _ |           
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |  ; : | ' @  |
 * |------+------+------+------+------+------|PP MUTE|    | MOUSE |------+------+------+------+------+------|
 * |LCTRL |   Z  |   X  |   C  |   V  |   B  |       |    |   TOG |   N  |   M  | , <  | .  > | /  ? | ENTER|
 * `-----------------------------------------/-------/    \-------\-----------------------------------------'
 *            |LALT  |LCTRL |SHIFT |LOWER | /SPACE  /      \BCKSP  \  |RAISE |SHIFT | LOWER | RAISE|
 *            |      |      |      |      |/       /        \       \ |      |      |    TOG|   TOG|
 *            `-----------------------------------'          '-------''----------------------------'
 */
            bindings = <
            &sk LGUI &mt ESC N1  &as N2   &as N3   &kp N4    &as N5                              &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp EQUAL
                &sk LALT  &kp Q  &kp W    &kp E    &kp R     &kp T                               &kp Y  &kp U  &kp I     &kp O    &kp P    &as MINUS
                &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                               &kp H  &kp J  &kp K     &kp L    &as SEMI &kp SQT
                &sk LCTRL &kp Z  &kp X    &kp C    &kp V     &kp B &mt C_MUTE C_PP    &tog MOUSE &kp N  &kp M  &kp COMMA &kp DOT  &as FSLH &kp RET
                        &sk LALT &sk LCTRL &sk LSHFT &sl LOWER  &kp SPACE                &kp BSPC  &sl RAISE  &sk LSHFT   &tog LOWER &tog RAISE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
                >;
        };

        lower_layer {
            display-name = "lower";
/* LOWER
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |  –   |   ?  |   %  |  £   |  {_} |                    | NUMLK| L.SEL|   %  |R.SEL |  BASE| LOWER|
 * |      | n_dsh|      |      |   $  |      |                    |      |      |      |      |      |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ALT  |  —   |   ^  |  &   |   #  |  [_] |                    |DELETE|   7  |  8   |  9   |   +  |  -  _|
 * |      | m_dsh|      |   ?  |      |      |                    |      | HOME |  Up  | P UP |      |   £  |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  | CAPS |  <   |  >   |   *  |  (_) |-------.    ,-------|  .   |   4  |  5   |  6   |  "_" |  ' @ |
 * |      | WORD |      |      |      |      |PP MUTE|    | MOUSE |    = | Left |      | Right|      |      |
 * |------+------+------+------+------+------|MW-SCRL|    |   TOG |------+------+------+------+------+------|
 * |LCTR  |   |  |  `   |  !   |   =  |  <_> |-------|    |-------|  0   |   1  |  2   |  3   |  /   | ENTER|
 * |      |      |      |      |      |      |                    |INSERT| END  | Down |P DOWN|   *  |      |
 * `-----------------------------------------/       /    \      \------------------------------------------'
 *            | ALT  | CTRL |SHIFT |LOWER | /SPACE  /      \BCKSP \  |      | SHIFT|   TO | MOUSE|
 *            |  sk  |  sk  |  sk  |     |/       /         \      \ |      |      | BASE |   TOG|
 *            `----------------------------------'           '------''---------------------------'
 */
            bindings = <
                &trans &n_dsh &kp QMARK &kp PRCNT &mt DLLR POUND  &m_brc             &kp KP_NUM    &kp LS(LC(LEFT)) &kp PRCNT &kp LS(LC(RIGHT))  &to BASE &mt LS(N2) COMMA
                &trans &m_dsh &kp CARET &mt QMARK AMPS  &kp NUHS  &m_bkt                  &kp DEL       &kp KP_N7 &kp KP_N8 &kp KP_N9   &kp KP_PLUS   &mt POUND KP_MINUS
                &trans &caps_word   &kp LT    &kp GT   &kp STAR  &m_par                   &mt EQUAL DOT &kp KP_N4 &kp KP_N5 &kp KP_N6   &m_quo    &trans
                &trans &kp LS(NUBS) &kp GRAVE &kp EXCL &kp EQUAL &m_lgt &trans     &trans &kp KP_N0     &kp KP_N1 &kp KP_N2 &kp KP_N3   &mt KP_ASTERISK KP_SLASH &trans
                           &trans    &trans      &trans    &trans   &trans                &trans  &trans    &trans   &trans &tog MOUSE
            >;
            sensor-bindings = <
                &inc_dec_kp UP DOWN
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        raise_layer {
            display-name = "raise";
/* RAISE
 * ,-----------------------------------------.                     ,-----------------------------------------.
 * | GUI  |  –   | NEXT |PL/USE | PREV | MOUSE|                    | CAPS | NEXT |PL/USE| PREV | MOUSE|ADJUST|
 * |      |n_dash|FORWRD|  MUTE |REWIND|    mo|                    |      |FORWRD| MUTE |REWIND|    to|    to|
 * |------+------+------+-------+------+------|                    |------+------+------+------+------+------|
 * | ALT  |  —   |  ?   |SHIFT  |SHIFT |  GUI |                    |DELETE|L.SEL |   ^  |R.SEL | P UP |  F2  |
 * |      |m_dash|      |CTL ALT| CTRL |      |                    |      |      |      |      |      |      |
 * |------+------+------+-------+------+------|                    |------+------+------+------+------+------|
 * | TAB  | CAPS |  ALT |  CTRL | SHIFT| ALT  |-------.    ,-------|  END |  <-  |   v  |  ->  |   "  |   @  |
 * |------+------+------+-------+------+------|PP MUTE|    | GAME  |------+------+------+------+------+------|
 * |      |      |      |       |      |      |Win-Snap| |TAB-LA/LC|      |      | WIN  |      |      |      |
 * | CTRL | UNDO | CUT  | COPY  |PASTE |SELECT|-------|    |-------| HOME | Menu |PASTE+| PRSCN|P DOWN| ENTER|
 * `------------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |SHIFT |LOWER  | /SPACE  /       \BCKSP \  |RAISE | ENTER| MOUSE| BASE |
 *            |      |      |      |       |/       /         \      \ |      |      |   TOG|    TO|
 *            `------------------------------------'           '------''---------------------------'
 */
            bindings = <
      &trans &n_dsh &mt C_RW C_PREV &mt C_MUTE C_PP &mt C_FF C_NEXT &mo MOUSE          &kp CAPS &mt C_RW C_PREV  &mt C_MUTE C_PP &mt C_FF C_NEXT &to MOUSE &to ADJUST
             &trans &m_dsh &kp QMARK &sk LS(LC(LALT)) &sk LS(LCTRL) &sk LGUI           &kp DEL &kp LS(LC(LEFT))  &kp UP &kp LS(LC(RIGHT))     &kp PG_UP &kp F2
                &trans &kp CAPS &sk LALT &sk LCTRL &sk LSHFT &sk LALT                 &kp END  &kp LEFT         &kp DOWN  &kp RIGHT          &kp LS(N2) &kp LS(SQT)
          &trans &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(A)  &trans  &to GAME  &kp HOME &kp C_MENU       &kp LG(V) &kp PSCRN          &kp PG_DN &trans
                                         &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &tog MOUSE  &trans
            >;
            sensor-bindings = <
                &inc_dec_kp LG(LS(RIGHT)) LG(LS(LEFT)) // Snaps the chosen window to the monitor on your ->right/<-left
                &inc_dec_kp TAB LS(TAB)               // ALT: <-backward/forward-> through all your monitors' open programs. CTRL: <-backward/forward-> through open tabs  -- Ctrl + Alt + Tab: persistent window, no hold
            >;
        };

        adjust_layer {
/* ADJUST
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |      |      |      |   {  |  }   |                    | F13  |  F14 |  F15 |  F16 |  F17 | GAME |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |      |   —  |   ?  |   [  |  ]   |                    | F12  | 	F7  |  F8  |  F9  |	 F18 | BASE |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |  "   |   <  |  >   |   (  |  )   |-------.    ,-------| F11  |  F4  |  F5  |  F6  |  F19 | NUMLK|
 * |------+------+------+------+------+------|MIPS OFF|  |MIPS OFF|------+------+------+------+------+------|
 * |      |  \   |   ~  |   –  |   <  |  >   |-------|    |-------| F10  |  F1  |  F2  |  F3  |	 F20 |   "  |
 * |      |   ~  |      |      |      |      |                    |      |      |      |      |      |      |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |SHIFT |LOWER | /SPACE  /       \BCKSP \  |      | ENTER| MOUSE| MOUSE|
 *            |      |      |      |      |/       /         \      \ |      |      |    TO|    TO|
 *            `----------------------------------'           '------''---------------------------'
 */
            display-name = "adjust";
            bindings = <
            &trans &none &none &none   &kp LS(LBKT) &kp LS(RBKT)                             &kp F13 &kp F14 &kp F15 &kp F16 &kp F17  &to GAME
            &kp ESC &none  &m_dsh  &kp QMARK &kp LBKT &kp RBKT                               &kp F12 &kp F7 &kp F8 &kp F9 &kp F18     &to PLATF
            &trans &kp LS(N2) &kp LT &kp GT   &kp LPAR &kp RPAR                              &kp F11 &kp F4 &kp F5 &kp F6 &kp F19     &to BASE
&trans &mt TILDE2 NUBS &kp TILDE2 &n_dsh &kp LT  &kp GT &rgb_ug RGB_TOG      &rgb_ug RGB_TOG &kp F10 &kp F1 &kp F2 &kp F3 &kp F20     &kp LS(N2)
                         &trans &trans  &trans &trans  &trans                                  &trans  &trans &trans &to MOUSE &to MOUSE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        mouse_layer {
 /*
 * Mouse & Media
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI |Pwr_off|BT_PRV| BT 0 |BT_NXT|B_CLR |                    |BDIS 0| MWl.L|      |MWl.R |      | GAME |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |      |      |      |      |      |                    |DELETE|  M 1 | M Up |  M 2 |SEARCH|PLATFM|
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |      |      |      |      |      |-------.    ,-------|WheelU|M Left|M Down|M Rigt|  M 3 | BASE |
 * |------+------+------+------+------+------|PP MUTE|    |PLATFRM|------+------+------+------+------+------|
 * | ALT  |      |      |      |      |      |-------|    |-------|WheelD|BR_Bck|      |B_Fwd |Refrsh| ENTER|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |  ALT | CTRL |SHIFT |      | /SPACE  /       \BCKSP \  |      | SHIFT| MOUSE| MOUSE|
 *            |      |      |      |      |/       /         \      \ |      |      |    TG|    TG|
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "MOUSE";
            bindings = <
 &kp LGUI &ext_power EP_TOG &bt BT_PRV &bt BT_SEL 0 &bt BT_NXT &bt BT_CLR        &bt BT_DISC 0  &trans &trans &trans &trans   &to GAME
 &kp ESC  &trans &trans &sk LC(LALT) &sk LS(LALT) &trans                         &kp DEL &trans &trans &trans &trans          &to PLATF
 &kp TAB  &sk LGUI  &sk LALT &sk LCTRL &sk LSHFT &sk LALT                        &trans  &trans &trans &trans &trans          &to BASE
 &kp LALT &trans   &trans &trans  &trans &trans &mt C_MUTE C_PP        &to PLATF &trans  &trans &trans &trans &trans          &kp RET
               &kp LALT &kp LCTRL &kp LSHFT &none &kp SPACE                      &kp BSPC &none &sk LSHFT &trans &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        game_layer {
  /* GAMING 5
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |  [   |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |  0   |   #  |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  |  - _ |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |  M   |   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |   ;  |  '@  |
 * |------+------+------+------+------+------|PP_MUTE|    |PLATFRM|------+------+------+------+------+------|
 * |SPACE |   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  | ENTER|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |   /  | Alt  | CTRL | RAISE| /SHIFT  /       \BCKSP \  | RAISE| SHIFT|  GUI |  TAB |
 *            |      |      |      |    MO|/       /         \      \ |    MO|      |      |      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "GAMING";
            bindings = <
&mt LGUI RBRC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                        &kp N6 &kp N7 &kp N8  &kp N9      &kp N0   &mt LS(N2) NUHS
 &kp ESC      &kp Q &kp W &kp E &kp R &kp T                             &kp Y &kp U &kp I     &kp O       &kp P    &kp MINUS
 &kp M        &kp A &kp S &kp D &kp F &kp G                             &kp H &kp J &kp K     &kp L       &kp SEMI &kp SQT
 &kp SPACE    &kp Z &kp X &kp C &kp V &kp B &mt C_MUTE C_PP   &to PLATF &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RET
    &kp FSLH &kp LALT &kp LCTRL &mo GXTRA &kp LSHFT              &kp BSPC &mo GXTRA &kp LSHFT &kp LGUI &kp TAB
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        gxtra_layer {
/* GEXTRAS GAMING EXTRAS 6
* ,-----------------------------------------.                    ,-----------------------------------------.
 * |   ]  |   6  |   7  |   8  |   9  |   0  |                    |  TAB | PREV | STOP | NEXT |  = + |  #   |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   U  |   W  |   I  |   O  |   P  |                    |  DEL |L.SEL |  UP  | R.SEL| PGUP |  -   |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   H  |   J  |-------.    ,-------|  END | LEFT | DOWN | RIGHT| PGDN |  "   |
 * |------+------+------+------+------+------| BASE  |    |PLATFRM|------+------+------+------+------+------|
 * |SPACE |   K  |   L  |   N  |   ,  |   .  |-------|    |-------| HOME |  TAB |   ,  |   .  |   /  | ENTER|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |   /  | ALT  | CTRL | LOWER| /SHIFT  /       \BCKSP \  | LOWER| SHIFT|  GUI |   TAB|
 *            |      |      |      |    MO|/       /         \      \ |    MO|      |      |      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "GEXTRAS";
            bindings = <
 &kp LBRC &kp N6 &kp N7 &kp N8 &kp N9    &kp N0                       &kp TAB &kp C_PREV &mt C_MUTE C_PP &kp C_NEXT     &kp EQUAL &kp NUHS
  &kp ESC &kp U  &trans &kp I  &kp O     &kp P                        &kp DEL &kp LS(LC(LEFT)) &kp UP &kp LS(LC(RIGHT)) &kp PG_UP &kp MINUS
  &kp TAB &trans &trans &trans &kp H     &kp J                        &kp END  &kp LEFT        &kp DOWN  &kp RIGHT      &kp PG_DN &kp LS(N2)
&kp SPACE &kp K  &kp L  &kp N  &kp COMMA &kp DOT &to BASE   &to PLATF &kp HOME &kp TAB         &kp COMMA &kp DOT        &kp FSLH  &kp RET
               &trans &trans &trans &trans &trans                 &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        platf_layer {
/* PLATFORMER 7
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |  [   |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |  0   | TO 5 |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   Q  |   W  |   E  |   R  |   T  |                    | ESC  |   U  |  UP  |   O  |   P  |  - _ |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   F  |   G  |-------.    ,-------| TAB  | LEFT | DOWN | RIGHT|   ;  | BCKSP|
 * |------+------+------+------+------+------|PP_MUTE|    | BASE  |------+------+------+------+------+------|
 * |SPACE |   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  | ENTER|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |   ]  | GUI  |  ALT | CTRL | /SPACE  /       \SPACE \  |SHIFT | SHIFT| LGUI | BASE |
 *            |      |      |      |      |/       /         \      \ |      |      |      |      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "PLATFORM";
            bindings = <
 &mt LGUI RBRC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                  &kp N6  &kp N7   &kp N8   &kp N9    &kp N0   &to GAME
  &kp ESC &kp Q &kp W &kp E &kp R &kp T                            &kp ESC &kp U    &kp UP   &kp O     &kp P    &kp MINUS
  &kp TAB &kp A &kp S &kp D &kp F &kp G                            &kp TAB &kp LEFT &kp DOWN &kp RIGHT &kp SEMI &kp BSPC
&kp SPACE &kp Z &kp X &kp C &kp V &kp B &mt C_MUTE C_PP   &to BASE &kp N   &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RET
   &kp RBRC &kp LGUI &kp LALT &kp LCTRL &kp SPACE            &kp SPACE &kp LSHFT &kp LSHFT &kp LGUI &to BASE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };


    };
};
