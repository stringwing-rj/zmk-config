#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4
#define GAME 5
#define GXTRA 6
#define PLATF 7

&led_strip {
    chain-length = <36>;
};


&nice_view_spi {
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};

/ {
   // The conditional_layers block has been safely isolated and commented out here
   /*
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
   */


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

/*
 * QWERTY / DEFAULT / BASE
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | 	= + |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  |  -   |
 * |LCTRL |      |      |      |      |      |                    |      |      |      |      |      |   _  |                
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |  ;|: |  ' @ |
 * |------+------+------+------+------+------|PL/USE |    | LOWER |------+------+------+------+------+------|
 * |SHIFT |   Z  |   X  |   C  |   V  |   B  |  MUTE |    |   TOG |   N  |   M  |  ,   |  .   |  /   |  " " |
 * |      |      |      |      |      |      |-------|    |-------|      |      |   <  |   >  |   ?  | SHIFT|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |LOWER |SHIFT | /SPACE  /       \BCKSP \  |RAISE | ENTER| MOUSE| RAISE|
 *            |      |      |      |      |/       /         \      \ |      |      |   TOG|   TOG|
 *            `----------------------------------'           '------''---------------------------'
 */
            bindings = <
                &kp LGUI  &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp EQUAL
            &mt LCTRL ESC &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp MINUS
                &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
                &sk LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B &mt C_MUTE C_PP &tog LOWER &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &mt RSHFT LS(N2)
                                &sk LALT &sk LCTRL &sl LOWER &sk LSHFT  &kp SPACE    &kp BSPC  &sl RAISE  &kp RET &tog MOUSE  &tog RAISE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
                >;
        };

        lower_layer {
            display-name = "lower";
/* LOWER
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  | CAPS |   ?  |   %  |  £   |  {   |                    | NUMLK| L.SEL|   £  |R.SEL |   %  |   ?  |
 * |      |      |      |      |   $  |   }  |                    |      |      |      |      |      |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   \  |   ^  |  &   |   #  |  [   |                    |DELETE|   7  |  8   |  9   |   *  |   -  |
 * | LCTRL|   ~  |      |      |      |   ]  |                    |      | HOME |  Up  | P UP |      |    _ |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  | CAPS |  <   |  >   |   *  |  (   |-------.    ,-------|   .  |   4  |  5   |  6   |   +  |  %   |
 * |      | WORD |      |      |      |   )  |PL/USE |    | LOWER |   =  | Left |      | Right|      |   ,  |
 * |------+------+------+------+------+------|       |    |   TOG |------+------+------+------+------+------|
 * |SHIFT |   |  |  `   |  !   |   =  |  <   |-------|    |-------|  0   |   1  |  2   |  3   |   /  |  ""  |
 * |      |      |      |      |      |   >  |                    |INSERT| END  | Down |P DOWN|      |RSHIFT|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |LOWER |SHIFT | /SPACE  /       \BCKSP \  |      | ENTER| MOUSE|TG    |
 *            |  OSL |  OSL |      |  OSL |/       /         \      \ |      |      |    MO|      |
 *            `----------------------------------'           '------''---------------------------'
 */
            bindings = <
                &trans  &kp CAPS  &kp QMARK &kp PRCNT &mt POUND DLLR &mt LS(RBKT) LS(LBKT)       &kp KP_NUM &kp LS(LC(LEFT)) &kp POUND &kp LS(LC(RIGHT)) &kp PRCNT &kp QMARK
                &trans  &mt TILDE2 NUBS &kp CARET &kp AMPS &kp NUHS &mt RBKT LBKT                &kp DEL      &kp KP_N7 &kp KP_N8 &kp KP_N9   &kp KP_ASTERISK  &kp KP_MINUS
                &trans &caps_word &kp LT   &kp GT  &kp STAR  &mt RPAR LPAR                      &mt EQUAL DOT &kp KP_N4 &kp KP_N5 &kp KP_N6   &kp KP_PLUS      &mt COMMA PRCNT
                &trans  &kp LS(NUBS) &kp GRAVE &kp EXCL &kp EQUAL  &mt GT LT   &trans    &trans  &kp KP_N0    &kp KP_N1 &kp KP_N2 &kp KP_N3   &kp KP_SLASH     &trans
                                    &trans    &trans      &trans    &trans   &trans        &trans  &trans    &kp RET   &tog MOUSE  &tog LOWER
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        raise_layer {
            display-name = "raise";
/* RAISE
 * ,----------------------------------------.                     ,-----------------------------------------.
 * | GUI  |      |      |      |   {  |   }  |                    | CAPS |      |      |      | MOUSE|ADJUST|
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |      |      |      |   [  |   ]  |                    |DELETE|L.SEL |   ^  |R.SEL |C_MENU|  F2  |
 * | CTRL |      |      |      |      |      |                    |      |      |      |      |      |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |  \ | |   <  |  >   |   (  |   )  |-------.    ,-------|  END |  <-  |   v  |  ->  | P UP |  F2  |
 * |------+------+------+------+------+------|PL/USE |    |       |------+------+------+------+------+------|
 * |SHIFT | UNDO | CUT  | COPY |PASTE |SELECT|-------|    |-------| HOME | EMAIL|CPRSCN| PRSCN|P DOWN|  " " |
 * |      |      |      |      |      |      |                    |      |      |      |      |      | SHIFT|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |LOWER |SHIFT | /SPACE  /       \BCKSP \  |RAISE | ENTER| MOUSE| RAISE|
 *            |      |      |      |      |/       /         \      \ |      |      |    MO|   TOG|
 *            `----------------------------------'           '------''---------------------------'
 */
            bindings = <
                &trans     &trans      &trans    &trans   &kp LS(LBKT) &kp LS(RBKT)               &kp CAPS &trans            &trans   &trans             &to MOUSE &to ADJUST
                &trans     &trans      &trans    &trans    &kp LBKT    &kp RBKT                   &kp DEL  &kp LS(LC(LEFT))  &kp UP   &kp LS(LC(RIGHT))  &kp C_MENU &kp F2
                &trans     &kp NUBS    &kp LT    &kp GT    &kp LPAR    &kp RPAR                   &kp END  &kp LEFT          &kp DOWN &kp RIGHT          &kp PG_UP  &kp F2
                &trans     &kp LC(Z)   &kp LC(X) &kp LC(C) &kp LC(V)   &kp LC(A) &trans    &none  &kp HOME &kp C_MENU        &trans   &trans             &kp PG_DN  &trans
                                         &trans       &trans       &trans       &trans            &trans  &trans  &trans    &trans    &mo MOUSE   &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        adjust_layer {
/* ADJUST
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |BLU 0 |BLU 1 |BLU 2 |BLU 3 |BLU 4 |BLU 5 |                    | F13  |  F14 |  F15 |  F16 |  F17 | GAME |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |B.PROF|UNDRGL|UNDRGL|UNDRGL|UNDRGL|UNDRGL|                    | F12  | 	F7  |  F8  |  F9  |	 F18 | BASE |
 * | CLEAR| HUE- | HUE+ | SAT- | SAT+ | NXT+ |                    |      |      |      |      |      |      | 
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | EXT  |UNDRGL|UNDRGL| BLU  | BLU  |B.PROF|-------.    ,-------| F11  |  F4  |  F5  |  F6  |  F19 | NUMLK|
 * |  PWR | BRI- | BRI+ | PRV- | NXT+ | CLEAR|UNDRGL |    |  BASE |      |      |      |      |      |      | 
 * |------+------+------+------+------+------|ON/OFF |    |       |------+------+------+------+------+------|
 * |BDIS 0|BDIS 1|BDIS 2|BDIS 3|BDIS 4|BDIS 5|-------|    |-------| F10  |  F1  |  F2  |  F3  |	 F20 | GAME |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |LOWER |SHIFT | /SPACE  /       \BCKSP \  |      | ENTER| MOUSE| CTRL |
 *            |      |      |      |      |/       /         \      \ |      |      |    MO|      |
 *            `----------------------------------'           '------''---------------------------'
 */
                // ----------------------------------------------------------------------------------------------------------------------------
                // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |  GAME |
                // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |DEFAULT|
                // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |NUM LCK|
                // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |  GAME |
                //                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "adjust";
            bindings = <
                &bt BT_SEL 0       &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &bt BT_SEL 5                           &kp F13 &kp F14 &kp F15 &kp F16 &kp F17  &to GAME
                &bt BT_CLR         &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &kp F12 &kp F7 &kp F8 &kp F9 &kp F18     &to BASE
                &ext_power EP_TOG  &rgb_ug RGB_BRD &rgb_ug RGB_BRI &bt BT_PRV      &bt BT_NXT      &bt BT_CLR                              &kp F11 &kp F4 &kp F5 &kp F6 &kp F19     &kp KP_NUM
                &bt BT_DISC 0      &bt BT_DISC 1   &bt BT_DISC 2   &bt BT_DISC 3   &bt BT_DISC 4   &bt BT_DISC 5 &rgb_ug RGB_TOG  &to BASE &kp F10 &kp F1 &kp F2 &kp F3 &kp F20     &to GAME
                                                          &kp LALT &kp LCTRL  &to BASE &kp LSHFT   &kp SPACE                           &kp BSPC  &to BASE &kp RET &mo MOUSE &kp LCTRL
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        mouse_layer {



            display-name = "MOUSE";
            bindings = <
 &kp LGUI &trans &trans &trans &trans &to BASE                                &trans &trans &trans &trans &trans &to GAME
 &kp ESC &trans &trans &kp C_MUTE &trans &trans                             &kp DEL &trans &trans &trans &trans &to BASE
 &kp TAB &trans &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_UP                 &trans &trans &trans &trans &trans &trans
 &kp LALT &trans &trans &trans &kp C_MUTE &kp C_VOL_DN &kp C_PP  &kp C_MUTE &trans &trans &trans &trans &trans &trans
               &kp LALT &kp LCTRL &kp LSHFT &none &kp SPACE    &kp BSPC &none &kp RET &trans &kp LCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        game_layer {

            display-name = "GAMING";
            bindings = <
&mt LGUI RBRC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                &trans &trans &trans &trans &trans &trans
 &kp ESC &kp Q &kp W &kp E &kp R &kp T                      &trans &trans &trans &trans &trans &trans
 &kp M &kp A &kp S &kp D &kp F &kp G                          &trans &trans &trans &trans &trans &trans
&kp SPACE &kp Z &kp X &kp C &kp V &kp B &kp C_PP   &kp C_MUTE &trans &trans &trans &trans &trans &trans
               &kp FSLH &kp LALT &kp LCTRL &mo GXTRA &kp LSHFT     &kp BSPC &mo GXTRA &kp RET &kp LGUI &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        gxtra_layer {

            display-name = "GEXTRAS";
            bindings = <
 &kp LBRC &kp N6 &kp N7 &kp N8 &kp N9 &kp N0                        &trans &trans &trans &trans &trans &trans
 &kp ESC &kp U  &trans &kp I  &kp O &kp P                          &trans &trans &trans &trans &trans &trans
 &kp TAB &trans &trans &trans &kp H &kp J                          &trans &trans &trans &trans &trans &trans
 &kp SPACE &kp K &kp L &kp N &kp COMMA &kp DOT &to BASE  &to PLATF  &trans &trans &trans &trans &trans &trans
               &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        platf_layer {
            display-name = "PLATFORM";
            bindings = <
 &mt LGUI RBRC &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &kp SPACE &trans &trans &trans &trans &trans &kp C_PP &to BASE &trans &trans &trans &trans &trans &trans
    &kp RBRC &kp LGUI &kp LALT &kp LCTRL &kp SPACE    &kp SPACE &kp LSHFT &kp RET &kp BSPC &kp BSLH
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };


    };
};
