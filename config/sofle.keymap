#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4
#define GAME 5
#define GXTRA 6
#define PLATF 7

&led_strip {
    chain-length = <36>;
};


&nice_view_spi {
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};



/ {
    // 1. BEHAVIORS BLOCK
    behaviors {
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTOSHIFT_HOLD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <148>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <80>;
            bindings = <&shifted>, <&kp>;
        };
    };

    // 2. MACROS BLOCK
    macros {
        shifted: macro_shifted_kp {
            #binding-cells = <1>;
            label = "MACRO_SHIFTED_KP";
            compatible = "zmk,behavior-macro-one-param";
            bindings =
                <&macro_press>,
                <&kp LSHFT &macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KP";
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };
    };

    // Your existing keymap code continues below...





   // The conditional_layers block has been safely isolated and commented out here
   
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
   


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

/*
 * QWERTY / DEFAULT / BASE
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |   0  | 	= + |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |LALT  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  |  - _ |           
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |  ;|: |  ' @ |
 * |------+------+------+------+------+------|PL/USE |    | LOWER |------+------+------+------+------+------|
 * |LCTRL |   Z  |   X  |   C  |   V  |   B  |  MUTE |    |   TOG |   N  |   M  | , <  | .  > | /  ? | ENTER|
 * `-----------------------------------------/-------/    \-------\-----------------------------------------'
 *            |LALT  |LCTRL |SHIFT |LOWER | /SPACE  /      \BCKSP  \  |RAISE |SHIFT | MOUSE| RAISE|
 *            |      |      |      |      |/       /        \       \ |      |      |    MO|   TOG|
 *            `-----------------------------------'          '-------''---------------------------'
 */
            bindings = <
                &sk LGUI  &kp N1 &kp N2   &as N3   &kp N4    &as N5                              &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp EQUAL
                &sk LALT  &kp Q  &kp W    &kp E    &kp R     &kp T                               &kp Y  &kp U  &kp I     &kp O    &kp P    &as MINUS
                &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                               &kp H  &kp J  &kp K     &kp L    &as SEMI &kp SQT
                &sk LCTRL &kp Z  &kp X    &kp C    &kp V     &kp B &mt C_MUTE C_PP    &tog MOUSE &kp N  &kp M  &kp COMMA &kp DOT  &as FSLH &kp RET
                                &sk LALT &sk LCTRL &sk LSHFT &sl LOWER  &kp SPACE        &kp BSPC  &sl RAISE  &sk LSHFT   &tog LOWER &tog RAISE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
                >;
        };

        lower_layer {
            display-name = "lower";
/* LOWER
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  | CAPS |   ?  |   %  |  £   |  {   |                    | NUMLK| L.SEL|   %  |R.SEL |  BASE| LOWER|
 * |      |      |      |      |   $  |   }  |                    |      |      |      |      |      |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ALT  |   \  |   ^  |  &   |   #  |  [   |                    |DELETE|   7  |  8   |  9   |   *  |  -  _|
 * |      |   ~  |      |   ?  |      |   ]  |                    |      | HOME |  Up  | P UP |      |   £  |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  | CAPS |  <   |  >   |   *  |  (   |-------.    ,-------|  .   |   4  |  5   |  6   |   +  |  "   |
 * |      | WORD |      |      |      |   )  |PL/USE |    | LOWER |    = | Left |      | Right|      |   ,  |
 * |------+------+------+------+------+------|       |    |   TOG |------+------+------+------+------+------|
 * |LCTR  |   |  |  `   |  !   |   =  |  <   |-------|    |-------|  0   |   1  |  2   |  3   |   /  | ENTER|
 * |      |      |      |      |      |   >  |                    |INSERT| END  | Down |P DOWN|      |      |
 * `-----------------------------------------/       /    \      \------------------------------------------'
 *            | ALT  | CTRL |SHIFT |LOWER | /SPACE  /      \BCKSP \  |      | ENTER|   TO | LOWER|
 *            |  sk  |  sk  |  sk  |     |/       /         \      \ |      |      | BASE |   TOG|
 *            `----------------------------------'           '------''---------------------------'
 */
            bindings = <
                &trans &kp CAPS  &kp QMARK &kp PRCNT &mt DLLR POUND &mt LS(RBKT) LS(LBKT)      &kp KP_NUM    &kp LS(LC(LEFT)) &kp PRCNT &kp LS(LC(RIGHT)) &to BASE &tog LOWER
                &trans &kp LS(N2) &kp CARET &mt QMARK AMPS &kp NUHS &mt RBKT LBKT              &kp DEL       &kp KP_N7 &kp KP_N8 &kp KP_N9   &kp KP_ASTERISK  &mt POUND KP_MINUS
                &trans &caps_word &kp LT  &kp GT  &kp STAR  &mt RPAR LPAR                      &mt EQUAL DOT &kp KP_N4 &kp KP_N5 &kp KP_N6   &kp KP_PLUS      &mt COMMA LS(N2)
                &trans &kp LS(NUBS) &kp GRAVE &kp EXCL &kp EQUAL &mt GT LT   &trans     &trans &kp KP_N0     &kp KP_N1 &kp KP_N2 &kp KP_N3   &kp KP_SLASH     &trans
                                  &trans    &trans      &trans    &trans   &trans        &trans  &trans    &kp BSPC   &trans &none
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        raise_layer {
            display-name = "raise";
/* RAISE
 * ,-----------------------------------------.                     ,-----------------------------------------.
 * | GUI  |      | NEXT |PL/USE | PREV | MOUSE|                    | CAPS | NEXT |PL/USE| PREV | MOUSE|ADJUST|
 * |      |      |FORWRD|  MUTE |REWIND|    mo|                    |      |FORWRD| MUTE |REWIND|    to|    to|
 * |------+------+------+-------+------+------|                    |------+------+------+------+------+------|
 * | ESC  | CAPS |      |SHIFT  |SHIFT |  GUI |                    |DELETE|L.SEL |   ^  |R.SEL |C_MENU|   £  |
 * |      |      |      |CTL ALT| CTRL |      |                    |      |      |      |      |      |      |
 * |------+------+------+-------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |CP_WRD| SHIFT|  ALT  | CTRL | SHIFT|-------.    ,-------|  END |  <-  |   v  |  ->  | P UP |  F2  |
 * |------+------+------+-------+------+------|PL/USE |    |       |------+------+------+------+------+------|
 * | CTRL | UNDO | CUT  | COPY  |PASTE |SELECT|-------|    |-------| HOME | EMAIL|CPRSCN| PRSCN|P DOWN| ENTER|
 * `------------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |SHIFT |LOWER  | /SPACE  /       \BCKSP \  |RAISE | ENTER| MOUSE| RAISE|
 *            |      |      |      |       |/       /         \      \ |      |      |    MO|   TOG|
 *            `------------------------------------'           '------''---------------------------'
 */
            bindings = <
            &trans &trans &mt C_RW C_PREV &mt C_MUTE C_PP &mt C_FF C_NEXT &mo MOUSE           &kp CAPS &mt C_RW C_PREV  &mt C_MUTE C_PP &mt C_FF C_NEXT &to MOUSE &to ADJUST
                &kp ESC &kp CAPS &trans &sk LS(LC(LALT)) &sk LS(LCTRL) &sk LGUI               &kp DEL &kp LS(LC(LEFT)) &kp UP &kp LS(LC(RIGHT)) &kp C_MENU &kp POUND
                &trans  &caps_word &sk LSHFT &sk LALT &sk LCTRL &sk LSHFT                     &kp END  &kp LEFT         &kp DOWN  &kp RIGHT    &kp PG_UP  &kp F2
                &trans  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LC(A)  &trans   &to GAME  &kp HOME &kp C_MENU       &kp LG(V) &kp PSCRN    &kp PG_DN  &trans
                                         &trans  &trans  &trans  &trans  &trans             &trans  &trans  &trans  &none  &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        adjust_layer {
/* ADJUST
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |      |      |      |   {  |  }   |                    | F13  |  F14 |  F15 |  F16 |  F17 | GAME |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |      |      |      |  \   |   [  |  ]   |                    | F12  | 	F7  |  F8  |  F9  |	 F18 | BASE |
 * |      |      |      |   ~  |      |      |                    |      |      |      |      |      |      |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |  "   |   <  |  >   |   (  |  )   |-------.    ,-------| F11  |  F4  |  F5  |  F6  |  F19 | NUMLK|
 * |------+------+------+------+------+------|UNDRGL |    |  BASE |------+------+------+------+------+------|
 * |      |      |      |   ~  |   <  |  >   |-------|    |-------| F10  |  F1  |  F2  |  F3  |	 F20 |   "  |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            | ALT  | CTRL |SHIFT |LOWER | /SPACE  /       \BCKSP \  |      | ENTER| MOUSE| CTRL |
 *            |      |      |      |      |/       /         \      \ |      |      |    MO|      |
 *            `----------------------------------'           '------''---------------------------'
 */
            display-name = "adjust";
            bindings = <
              &trans &trans &trans &trans   &kp LS(LBKT) &kp LS(RBKT)                             &kp F13 &kp F14 &kp F15 &kp F16 &kp F17  &to GAME
              &trans &none  &none  &mt TILDE2 NUBS &kp LBKT &kp RBKT                              &kp F12 &kp F7 &kp F8 &kp F9 &kp F18     &to BASE
            &trans &kp LS(N2) &kp LT &kp GT   &kp LPAR  &kp RPAR                                  &kp F11 &kp F4 &kp F5 &kp F6 &kp F19     &to GAME
              &trans &trans &trans &kp TILDE2 &kp LT  &kp GT     &trans                  &to BASE &kp F10 &kp F1 &kp F2 &kp F3 &kp F20     &kp LS(N2)
                         &trans &trans  &trans &trans  &trans                      &trans  &trans &trans &none &to BASE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        mouse_layer {
 /*
 * Mouse & Media
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * | GUI  |BDIS 0|BT_PRV| BT 0 |BT_NXT|B_CLR |                    |      | MWl.L|      |MWl.R |      | GAME |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |      |      |      |      |      |                    |DELETE|  M 1 | M Up |  M 2 |SEARCH| BASE |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |      |      |      |      |      |-------.    ,-------|WheelU|M Left|M Down|M Rigt|  M 3 | MOUSE|
 * |      |      |      |      |      |      |                    |      |      |      |      |      |   tog|
 * |------+------+------+------+------+------|UNDRGLO|    | SEARCH|------+------+------+------+------+------|
 * | ALT  |      |      |      |      |      |-------|    |-------|WheelD|BR_Bck|B_Fwd |Refrsh|      | ENTER|
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |  ALT | CTRL |SHIFT |      | /SPACE  /       \BCKSP \  |      | ENTER| MOUSE| CTRL |
 *            |      |      |      |      |/       /         \      \ |      |      |    TG|      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "MOUSE";
            bindings = <
 &kp LGUI &bt BT_DISC 0 &bt BT_PRV &bt BT_SEL 0 &bt BT_NXT &bt BT_CLR                   &trans  &trans &trans &trans &trans     &to GAME
 &kp ESC  &trans &trans &sk LC(LALT) &sk LS(LALT) &trans                             &kp DEL &trans &trans &trans &trans    &to BASE
 &kp TAB  &sk LGUI  &sk LSHFT &sk LALT &sk LCTRL &sk LSHFT                                 &trans  &trans &trans &trans &trans     &tog MOUSE
 &kp LALT &trans &trans    &trans   &trans    &trans  &rgb_ug RGB_TOG &ext_power EP_TOG &trans  &trans &trans &trans &trans   &kp RET
               &kp LALT &kp LCTRL &kp LSHFT &none &kp SPACE                      &kp BSPC &none &kp RET &trans &tog MOUSE
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        game_layer {
  /* GAMING 5
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |  [   |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |  0   |   #  |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   Q  |   W  |   E  |   R  |   T  |                    |   Y  |   U  |   I  |   O  |   P  |  - _ |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * |  M   |   A  |   S  |   D  |   F  |   G  |-------.    ,-------|   H  |   J  |   K  |   L  |   ;  |  '@  |
 * |------+------+------+------+------+------|PL/USE |    | M_HREM|------+------+------+------+------+------|
 * |SPACE |   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  | 	 "  |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |   /  | Alt  | CTRL | RAISE| /SHIFT  /       \BCKSP \  | RAISE| ENTER|  GUI |  TAB |
 *            |      |      |      |    MO|/       /         \      \ |    MO|      |      |      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "GAMING";
            bindings = <
&mt LGUI RBRC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                &trans &trans &trans &trans &trans &trans
 &kp ESC &kp Q &kp W &kp E &kp R &kp T                      &trans &trans &trans &trans &trans &trans
 &kp M &kp A &kp S &kp D &kp F &kp G                          &trans &trans &trans &trans &trans &trans
&kp SPACE &kp Z &kp X &kp C &kp V &kp B &kp C_PP   &kp C_MUTE &trans &trans &trans &trans &trans &trans
               &kp FSLH &kp LALT &kp LCTRL &mo GXTRA &kp LSHFT     &kp BSPC &mo GXTRA &kp RET &kp LGUI &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        gxtra_layer {
/* GEXTRAS GAMING EXTRAS 6
* ,-----------------------------------------.                    ,-----------------------------------------.
 * |   ]  |   6  |   7  |   8  |   9  |   0  |                    |  TAB | PREV | STOP | NEXT |  = + |  #   |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   U  |   W  |   I  |   O  |   P  |                    |  DEL |L.SEL |  UP  | R.SEL| PGUP |  -   |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   H  |   j  |-------.    ,-------|  END | LEFT | DOWN | RIGHT| PGDN |  '@  |
 * |------+------+------+------+------+------|  TO 0 |    | TO 7  |------+------+------+------+------+------|
 * |SPACE |   K  |   L  |   N  |   ,  |   .  |-------|    |-------| HOME |  TAB |   ,  |   .  |   /  | 	 "  |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |   /  | ALT  | CTRL | LOWER| /SHIFT  /       \BCKSP \  | LOWER| ENTER|  GUI |      |
 *            |      |      |      |    MO|/       /         \      \ |    MO|      |      |      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "GEXTRAS";
            bindings = <
 &kp LBRC &kp N6 &kp N7 &kp N8 &kp N9 &kp N0                        &trans &trans &trans &trans &trans &trans
 &kp ESC &kp U  &trans &kp I  &kp O &kp P                          &trans &trans &trans &trans &trans &trans
 &kp TAB &trans &trans &trans &kp H &kp J                          &trans &trans &trans &trans &trans &trans
 &kp SPACE &kp K &kp L &kp N &kp COMMA &kp DOT &to BASE  &to PLATF  &trans &trans &trans &trans &trans &trans
               &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        platf_layer {
/* PLATFORMER 7
 * ,-----------------------------------------.                    ,-----------------------------------------.
 * |  [   |   1  |   2  |   3  |   4  |   5  |                    |   6  |   7  |   8  |   9  |  0   | TO 5 |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | ESC  |   Q  |   W  |   E  |   R  |   T  |                    | ESC  |   U  |  UP  |   O  |   P  |  - _ |
 * |------+------+------+------+------+------|                    |------+------+------+------+------+------|
 * | TAB  |   A  |   S  |   D  |   F  |   G  |-------.    ,-------| TAB  | LEFT | DOWN | RIGHT|   ;  |  '@  |
 * |------+------+------+------+------+------|  VOL+ |    | TG 0  |------+------+------+------+------+------|
 * |SPACE |   Z  |   X  |   C  |   V  |   B  |-------|    |-------|   N  |   M  |   ,  |   .  |   /  | VOL- |
 * `-----------------------------------------/       /     \      \-----------------------------------------'
 *            |   ]  | GUI  |  ALT | CTRL | /SPACE  /       \SPACE \  |SHIFT | ENTER| BCKSP|   #  |
 *            |      |      |      |      |/       /         \      \ |      |      |      |      |
 *             `----------------------------------'           '------''---------------------------'
 */
            display-name = "PLATFORM";
            bindings = <
 &mt LGUI RBRC &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &kp SPACE &trans &trans &trans &trans &trans &kp C_PP &to BASE &trans &trans &trans &trans &trans &trans
    &kp RBRC &kp LGUI &kp LALT &kp LCTRL &kp SPACE    &kp SPACE &kp LSHFT &kp RET &kp BSPC &kp BSLH
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };


    };
};
