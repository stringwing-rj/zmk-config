#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4
#define GAME 5
#define GXTRA 6
#define PLATF 7

&led_strip {
    chain-length = <36>;
};


&nice_view_spi {
    cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};

/ {
   // The conditional_layers block has been safely isolated and commented out here
   /*
    conditional_layers {
        compatible = "zmk,conditional-layers";
        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
   */


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
                // ------------------------------------------------------------------------------------------------------------
                // |  GUI  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  =  + |
                // ------------------------------------------------------------------------------------------------------------
                // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |  - _  |
                     LCTRL
                // ------------------------------------------------------------------------------------------------------------
                // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
                // ------------------------------------------------------------------------------------------------------------
                // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  PLAY/ |  |       |  N   |  M    |  ,    |  .   |   /   |  " "  |
                                                                PAUSE                                                   SHIFT
                // ------------------------------------------------------------------------------------------------------------
                //               | ALT | CTRL | LOWER| SHIFT|  SPACE |  | BKSPC | RAISE| ENTER | ALT   | GUI  |
            bindings = <
                &kp LGUI  &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp EQUAL
            &mt LCTRL ESC &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp MINUS
                &kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
                &sk LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B      &kp C_PP   &kp C_MUTE &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &mt RSHFT LS(N2)
                                &sk LALT &sk LCTRL &sl LOWER &sk LSHFT  &kp SPACE    &kp BSPC  &sl RAISE  &kp RET &tog LOWER  &tog RAISE
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
                >;
        };

        lower_layer {
            display-name = "lower";
                // ------------------------------------------------------------------------------------------------------------
                // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
                // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
                // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
                // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
                //               |     |      |      |      |        |  |       |      |       |       |      |
            bindings = <
                &trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8    &kp F9    &kp F10   &kp F11
                &kp GRAVE &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                    &kp N6    &kp N7   &kp N8    &kp N9    &kp N0    &kp F12
                &trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                 &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR  &kp PIPE
                &trans    &kp EQUAL &kp MINUS &kp PLUS &kp LBRC  &kp RBRC   &trans &trans  &kp LBKT  &kp RBKT &kp SEMI  &kp COLON &kp BSLH  &trans
                                    &trans    &trans      &trans    &trans     &trans &trans  &trans    &trans   &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        raise_layer {
            display-name = "raise";
                // ------------------------------------------------------------------------------------------------------------
                // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      | MOUSE | ADJUST|
                // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
                // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
                // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
                //                |      |       |       |      |      |  |      |      |      |       |      |
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                  &trans    &trans    &trans   &trans    &to MOUSE &to ADJUST
                &trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                        &kp PG_UP &trans    &kp UP   &trans    &kp N0  &trans
                &trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                      &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
                &trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans        &trans  &trans  &trans    &trans    &trans   &trans    &trans  &trans
                                        &trans       &trans       &trans       &trans        &trans  &trans  &trans    &trans    &trans   &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        adjust_layer {
                // ----------------------------------------------------------------------------------------------------------------------------
                // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |  GAME |
                // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |DEFAULT|
                // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |NUM LCK|
                // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |  GAME |
                //                    |         |         |         |         |         | |      |      |      |       |      |
            display-name = "adjust";
            bindings = <
                &bt BT_CLR        &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &none &none &none &none &none &to GAME
                &ext_power EP_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF                         &none &none &none &none &none &to BASE
                &none             &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none           &none           &none                                   &none &none &none &none &none &kp KP_NUM
                &none             &none           &none           &none           &none           &none            &rgb_ug RGB_TOG &none  &none &none &none &none &none &to GAME
                                                &none           &none           &none           &none            &none           &none  &none &none &none &none
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN 
                &inc_dec_kp PG_UP PG_DN
            >;
        };

        mouse_layer {



            display-name = "MOUSE";
            bindings = <
 &kp LGUI &trans &trans &trans &trans &to BASE                    &trans &trans &trans &trans &trans &to GAME
 &kp ESC &trans &trans &kp C_MUTE &trans &trans                      &kp DEL &trans &trans &trans &trans &to BASE
 &kp TAB &trans &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_UP      &trans &trans &trans &trans &trans &trans
 &kp LALT &trans &trans &trans &trans &kp C_MUTE &kp C_VOL_DN        &trans &trans &trans &trans &trans &trans &trans
               &kp LALT &kp LCTRL &kp LSHFT &none &kp SPACE    &kp BSPC &none &kp RET &none &kp LCTRL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        game_layer {

            display-name = "GAMING";
            bindings = <
&mt LGUI RBRC &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                &trans &trans &trans &trans &trans &trans
 &kp ESC &kp Q &kp W &kp E &kp R &kp T                      &trans &trans &trans &trans &trans &trans
 &kp M &kp A &kp S &kp D &kp F &kp G                          &trans &trans &trans &trans &trans &trans
&kp SPACE &kp Z &kp X &kp C &kp V &kp B &kp C_PP   &kp C_MUTE &trans &trans &trans &trans &trans &trans
               &kp FSLH &kp LALT &kp LCTRL &mo GXTRA &kp LSHFT     &kp BSPC &mo GXTRA &kp RET &kp LGUI &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        gxtra_layer {

            display-name = "GEXTRAS";
            bindings = <
 &kp LBRC &kp N6 &kp N7 &kp N8 &kp N9 &kp N0                    &trans &trans &trans &trans &trans &trans
 &kp ESC &kp U  &trans &kp I  &kp O &kp P                      &trans &trans &trans &trans &trans &trans
 &kp TAB &trans &trans &trans &kp H &kp J                      &trans &trans &trans &trans &trans &trans
 &kp SPACE &kp K &kp L &kp N &kp COMMA &kp DOT &to BASE  &to PLATF  &trans &trans &trans &trans &trans &trans
               &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        platf_layer {
            display-name = "PLATFORM";
            bindings = <
 &mt LGUI RBRC &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &trans &trans &trans &trans &trans &trans                      &trans &trans &trans &trans &trans &trans
 &kp SPACE &trans &trans &trans &trans &trans &trans        &to BASE  &trans &trans &trans &trans &trans &trans
               &kp RBRC &kp LGUI &kp LALT &kp LCTRL &kp SPACE        &kp SPACE &kp LSHFT &kp RET &kp BSPC &kp BSLH
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };


    };
};
